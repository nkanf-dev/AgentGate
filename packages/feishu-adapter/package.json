{
  "name": "@agentgate/feishu-adapter",
  "version": "0.1.0",
  "private": false,
  "description": "Feishu long-connection approval transport for AgentGate.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agentgate-feishu-adapter": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "agentgate",
    "feishu",
    "approval",
    "security"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.62.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0"
  }
}
